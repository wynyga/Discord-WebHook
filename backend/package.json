{
  "name": "insignia-scheduler-backend",
  "version": "0.1.0",
  "description": "Discord webhook task scheduler API",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env src/infrastructure/database/migrate-cli.ts",
    "db:studio": "drizzle-kit studio"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "bullmq": "^6.7.8",
    "cors": "^2.8.6",
    "cron-parser": "^5.10.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "private": "true",
  "engines": {
    "node": ">=22"
  }
}
