# Optional: copy to .env to override. Every value below is a working local default, and
# docker-compose.yml has the same defaults built in, so `docker compose up` needs no .env at all.
# Never reuse JWT_SECRET or ADMIN_PASSWORD in production: with NODE_ENV=production the backend
# refuses to start with them.

# --- Backend (when run on the host with `npm run dev`) ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Host ports published by docker compose (postgres 5433, redis 6382). Inside compose the backend
# uses the service names instead; these two lines are ignored there.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/scheduler
REDIS_URL=redis://127.0.0.1:6382
JWT_SECRET=dev-only-change-me-at-least-32-chars
JWT_EXPIRES_IN=1h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGIN=http://localhost:5173
# Task runs processed in parallel by the worker.
WORKER_CONCURRENCY=5
# How long to wait for Discord before an attempt counts as a network failure.
DISCORD_TIMEOUT_MS=10000

# --- Docker Compose ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scheduler
# Host ports; change them if something else on your machine already uses one.
POSTGRES_PORT=5433
REDIS_PORT=6382
BACKEND_PORT=3000
FRONTEND_PORT=8080

# --- pgAdmin (docker compose --profile tools up -d) ---
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
