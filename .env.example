# Copy to .env to override. Every value below is a local default; docker-compose uses the same ones.
# Never reuse JWT_SECRET or ADMIN_PASSWORD in production: the backend refuses to start with them.

# --- Backend ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# localhost URLs are for running the backend on the host; docker-compose points them at its services.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scheduler
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-change-me-at-least-32-chars
JWT_EXPIRES_IN=1h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
# Task runs processed in parallel by the worker.
WORKER_CONCURRENCY=5
# How long to wait for Discord before an attempt counts as a network failure.
DISCORD_TIMEOUT_MS=10000

# --- Postgres container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scheduler

# --- pgAdmin (docker compose --profile tools up) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
